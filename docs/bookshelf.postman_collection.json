{
  "info": {
    "name": "Bookshelf API",
    "description": "Run top to bottom. Login stores the token in {{token}} for the protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "bookId", "value": "1" }
  ],
  "item": [
    {
      "name": "01 Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"reader@example.com\",\n  \"password\": \"password123\"\n}" },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "02 Login (saves token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.collectionVariables.set('token', pm.response.json().access_token);"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"reader@example.com\",\n  \"password\": \"password123\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "03 Create book WITHOUT token (401)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Dune\",\n  \"author\": \"Frank Herbert\"\n}" },
        "url": "{{baseUrl}}/books"
      }
    },
    {
      "name": "04 Create book WITH token (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.collectionVariables.set('bookId', pm.response.json().id);"]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Dune\",\n  \"author\": \"Frank Herbert\"\n}" },
        "url": "{{baseUrl}}/books"
      }
    },
    {
      "name": "05 Create book with empty title (400)",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"\",\n  \"author\": \"Frank Herbert\"\n}" },
        "url": "{{baseUrl}}/books"
      }
    },
    {
      "name": "06 List all books",
      "request": { "method": "GET", "url": "{{baseUrl}}/books" }
    },
    {
      "name": "07 Get one book",
      "request": { "method": "GET", "url": "{{baseUrl}}/books/{{bookId}}" }
    },
    {
      "name": "08 Update book (mark as read)",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"isRead\": true\n}" },
        "url": "{{baseUrl}}/books/{{bookId}}"
      }
    },
    {
      "name": "09 Delete book",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "DELETE",
        "url": "{{baseUrl}}/books/{{bookId}}"
      }
    },
    {
      "name": "10 Get missing book (404)",
      "request": { "method": "GET", "url": "{{baseUrl}}/books/999999" }
    }
  ]
}
